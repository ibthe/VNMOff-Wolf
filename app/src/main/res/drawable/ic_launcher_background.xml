<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- светлый лавандовый фон: на нём тёмная палитра 0101FB / 8E0398 даёт сильный контраст -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FFF8F5FF" android:offset="0.0" />
                <item android:color="#FFEBE2FF" android:offset="0.6" />
                <item android:color="#FFDCCBFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- мягкое свечение за головой волка -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="46"
                android:type="radial">
                <item android:color="#33FFFFFF" android:offset="0.0" />
                <item android:color="#1F8E0398" android:offset="0.7" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
